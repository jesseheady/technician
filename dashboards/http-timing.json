          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
            "renameByName": { "name": "Check", "region": "Site", "Value #P50": "P50", "Value #P90": "P90", "Value #P99": "P99" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
