{
  "uid": "technician-http-timing",
  "title": "Technician: HTTP Timing Breakdown",
  "tags": [
    "technician",
    "synthetic-monitoring"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "site_code",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "definition": "label_values(technician_http_dns_seconds, site_code)",
        "query": {
          "query": "label_values(technician_http_dns_seconds, site_code)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "probe",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "definition": "label_values(technician_http_dns_seconds{site_code=~\"$site_code\"}, name)",
        "query": {
          "query": "label_values(technician_http_dns_seconds{site_code=~\"$site_code\"}, name)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 999,
      "title": "",
      "type": "text",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:13px\"><a href=\"/d/technician-uptime-overview\" style=\"color:rgb(110,159,255);text-decoration:none\">Uptime</a><span style=\"color:#999;font-size:11px\">|</span><strong style=\"color:rgb(204,204,220)\">HTTP Timing</strong><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-budget-violations\" style=\"color:rgb(110,159,255);text-decoration:none\">Budgets</a><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-infrastructure-probes\" style=\"color:rgb(110,159,255);text-decoration:none\">Infrastructure</a><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-performance-vitals\" style=\"color:rgb(110,159,255);text-decoration:none\">Web Vitals</a><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-har-analysis\" style=\"color:rgb(110,159,255);text-decoration:none\">HAR Analysis</a></div>"
      }
    },
    {
      "id": 1,
      "title": "HTTP Timing Breakdown (Stacked)",
      "type": "barchart",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "technician_http_dns_seconds{site_code=~\"$site_code\", name=~\"$probe\"}",
          "legendFormat": "DNS - {{name}}",
          "refId": "A"
        },
        {
          "expr": "technician_http_tls_seconds{site_code=~\"$site_code\", name=~\"$probe\"}",
          "legendFormat": "TLS - {{name}}",
          "refId": "B"
        },
        {
          "expr": "technician_http_connect_seconds{site_code=~\"$site_code\", name=~\"$probe\"}",
          "legendFormat": "Connect - {{name}}",
          "refId": "C"
        },
        {
          "expr": "technician_http_ttfb_seconds{site_code=~\"$site_code\", name=~\"$probe\"}",
          "legendFormat": "TTFB - {{name}}",
          "refId": "D"
        },
        {
          "expr": "technician_http_transfer_seconds{site_code=~\"$site_code\", name=~\"$probe\"}",
          "legendFormat": "Transfer - {{name}}",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "stacking": "normal",
        "barWidth": 0.8,
        "groupWidth": 0.7
      }
    },
