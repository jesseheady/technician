{
  "uid": "technician-budget-violations",
  "title": "Technician: Budget Violations",
  "tags": [
    "technician",
    "synthetic-monitoring"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "definition": "label_values(technician_budget_violation, region)",
        "query": {
          "query": "label_values(technician_budget_violation, region)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "probe",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "definition": "label_values(technician_budget_violation{region=~\"$region\"}, name)",
        "query": {
          "query": "label_values(technician_budget_violation{region=~\"$region\"}, name)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 999,
      "title": "",
      "type": "text",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:13px\"><a href=\"/d/technician-uptime-overview\" style=\"color:rgb(110,159,255);text-decoration:none\">Uptime</a><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-http-timing\" style=\"color:rgb(110,159,255);text-decoration:none\">HTTP Timing</a><span style=\"color:#999;font-size:11px\">|</span><strong style=\"color:rgb(204,204,220)\">Budgets</strong><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-infrastructure-probes\" style=\"color:rgb(110,159,255);text-decoration:none\">Infrastructure</a><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-performance-vitals\" style=\"color:rgb(110,159,255);text-decoration:none\">Web Vitals</a><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-har-analysis\" style=\"color:rgb(110,159,255);text-decoration:none\">HAR Analysis</a></div>"
      }
    },
    {
      "id": 6,
      "title": "Budget Compliance",
      "description": "Percentage of all budget checks currently passing",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(1 - avg(technician_budget_violation{region=~\"$region\", name=~\"$probe\"})) * 100",
          "instant": true,
          "legendFormat": "Compliance",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 100 }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "No budgets configured"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 1,
      "title": "Violation Count",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(technician_budget_violation{region=~\"$region\", name=~\"$probe\"} == 1)",
          "instant": true,
          "legendFormat": "Violations",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Violations by Metric",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "technician_budget_violation{region=~\"$region\", name=~\"$probe\"} == 1",
          "instant": true,
          "legendFormat": "{{metric}} ({{name}} @ {{region}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "PASS", "color": "green" },
                "1": { "text": "FAIL", "color": "red" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "All budgets passing"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name"
      }
    },
    {
      "id": 3,
      "title": "Failing Probes",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "max by (name, region) (technician_budget_violation{region=~\"$region\", name=~\"$probe\"}) == 1",
          "instant": true,
          "legendFormat": "{{name}} @ {{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "PASS", "color": "green" },
                "1": { "text": "FAIL", "color": "red" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "All probes within budget",
          "links": [
            {
              "title": "Drill Down →",
              "url": "/d/technician-uptime-overview?var-probe=${__field.labels.name}&var-region=${__field.labels.region}&${__url_time_range}"
            }
          ]
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "All Budget Checks",
      "description": "Current status of every budget check. Violations sort to the top.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "technician_budget_violation{region=~\"$region\", name=~\"$probe\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "name" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Uptime Overview →",
                    "url": "/d/technician-uptime-overview?var-probe=${__data.fields.name}&var-region=${__data.fields.region}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Status" },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "PASS", "color": "green" },
                      "1": { "text": "FAIL", "color": "red" }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "city": true, "country": true },
            "indexByName": { "name": 0, "region": 1, "metric": 2, "Value": 3 },
            "renameByName": { "name": "Probe", "region": "Site", "metric": "Metric" }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "Status", "desc": true }]
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Budget Violation Rate Over Time",
      "description": "Percentage of checks violating budget per 5m window",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "avg_over_time(technician_budget_violation{region=~\"$region\", name=~\"$probe\"}[5m])",
          "legendFormat": "{{metric}} ({{name}} @ {{region}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "pointSize": 5, "showPoints": "auto", "spanNulls": false, "stacking": { "mode": "none" }, "gradientMode": "scheme" },
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 0.75 }
            ]
          },
          "color": { "mode": "continuous-GrYlRd" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ],
  "schemaVersion": 39
}
