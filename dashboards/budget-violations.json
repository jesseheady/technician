{
  "uid": "technician-budget-violations",
  "title": "Technician: Budget Violations",
  "tags": ["technician", "synthetic-monitoring"],
  "timezone": "browser",
  "editable": true,
  "refresh": "5m",
  "time": { "from": "now-1h", "to": "now" },
  "links": [
    { "title": "Uptime Overview", "type": "link", "url": "/d/technician-uptime-overview", "icon": "dashboard", "tooltip": "Probe uptime and availability" },
    { "title": "HTTP Timing", "type": "link", "url": "/d/technician-http-timing", "icon": "dashboard", "tooltip": "DNS, TLS, TTFB breakdown" },
    { "title": "Web Vitals", "type": "link", "url": "/d/technician-performance-vitals", "icon": "dashboard", "tooltip": "LCP, INP, CLS metrics" },
    { "title": "HAR Analysis", "type": "link", "url": "/d/technician-har-analysis", "icon": "dashboard", "tooltip": "Resource waterfall and transfer sizes" }
  ],
  "templating": {
    "list": [
      {
        "name": "site_code",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "definition": "label_values(technician_budget_violation, site_code)",
        "query": { "query": "label_values(technician_budget_violation, site_code)", "refId": "A" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "probe",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "definition": "label_values(technician_budget_violation{site_code=~\"$site_code\"}, name)",
        "query": { "query": "label_values(technician_budget_violation{site_code=~\"$site_code\"}, name)", "refId": "A" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Current Violation Count",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(technician_budget_violation{site_code=~\"$site_code\", name=~\"$probe\"} == 1)",
          "legendFormat": "Violations",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "0"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 2,
      "title": "Violations by Metric",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "technician_budget_violation{site_code=~\"$site_code\", name=~\"$probe\"} == 1",
          "legendFormat": "{{metric}} ({{name}} @ {{site_code}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "PASS", "color": "green" }, "1": { "text": "FAIL", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "name" }
    },
    {
      "id": 3,
      "title": "Budget Status (Pass/Fail by Probe)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "max by (name, site_code) (technician_budget_violation{site_code=~\"$site_code\", name=~\"$probe\"})",
          "legendFormat": "{{name}} @ {{site_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "PASS", "color": "green" }, "1": { "text": "FAIL", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 4,
      "title": "Budget Violation Rate Over Time",
      "description": "Percentage of checks violating budget per 5m window (median smoothing dampens outliers)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "avg_over_time(technician_budget_violation{site_code=~\"$site_code\", name=~\"$probe\"}[5m])",
          "legendFormat": "{{metric}} ({{name}} @ {{site_code}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "mode": "none" },
            "gradientMode": "scheme"
          },
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 0.75 }
            ]
          },
          "color": { "mode": "continuous-GrYlRd" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "title": "All Current Violations",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "technician_budget_violation{site_code=~\"$site_code\", name=~\"$probe\"} == 1",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Violated" },
              { "id": "mappings", "value": [{ "type": "value", "options": { "1": { "text": "YES", "color": "red" } } }] },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
            "renameByName": { "name": "Probe", "site_code": "Site", "metric": "Metric" }
          }
        }
      ]
    }
  ],
  "schemaVersion": 39
}
