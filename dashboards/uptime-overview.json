{
  "uid": "technician-uptime-overview",
  "title": "Technician: Uptime Overview",
  "tags": [
    "technician",
    "synthetic-monitoring"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "definition": "label_values(technician_check_healthy, region)",
        "query": {
          "query": "label_values(technician_check_healthy, region)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "definition": "label_values(technician_check_healthy{region=~\"$region\"}, type)",
        "query": {
          "query": "label_values(technician_check_healthy{region=~\"$region\"}, type)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "check",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "definition": "label_values(technician_check_healthy{region=~\"$region\", type=~\"$type\"}, name)",
        "query": {
          "query": "label_values(technician_check_healthy{region=~\"$region\", type=~\"$type\"}, name)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 999,
      "title": "",
      "type": "text",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:13px\"><strong style=\"color:rgb(204,204,220)\">Uptime</strong><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-http-timing\" style=\"color:rgb(110,159,255);text-decoration:none\">HTTP Timing</a><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-budget-violations\" style=\"color:rgb(110,159,255);text-decoration:none\">Budgets</a><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-infrastructure-probes\" style=\"color:rgb(110,159,255);text-decoration:none\">Infrastructure</a><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-performance-vitals\" style=\"color:rgb(110,159,255);text-decoration:none\">Web Vitals</a><span style=\"color:#999;font-size:11px\">|</span><a href=\"/d/technician-har-analysis\" style=\"color:rgb(110,159,255);text-decoration:none\">HAR Analysis</a></div>"
      }
    },
    {
      "id": 1,
      "title": "Failing Probes",
      "description": "Probes currently reporting DOWN. Click a tile to drill into details.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "technician_check_healthy{region=~\"$region\", type=~\"$type\", name=~\"$probe\"} == 0",
          "instant": true,
          "legendFormat": "{{name}} ({{type}}) @ {{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "All systems operational",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0 }
            ]
          },
          "color": { "mode": "thresholds" },
          "links": [
            {
              "title": "Drill Down →",
              "url": "/d/technician-uptime-overview?var-probe=${__field.labels.name}&var-region=${__field.labels.region}&${__url_time_range}"
            }
          ]
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Overall Uptime Percentage",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "avg(avg_over_time(technician_check_healthy{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}[$__range])) * 100",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Degraded Probes",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Probes where response time exceeds the degraded_after threshold. Only shows currently degraded probes.",
      "targets": [
        {
          "expr": "technician_check_degraded{region=~\"$region\", type=~\"$type\", name=~\"$probe\"} == 1",
          "instant": true,
          "legendFormat": "{{name}} ({{type}}) @ {{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "None degraded",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "DEGRADED", "color": "orange" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" },
          "links": [
            {
              "title": "Drill Down →",
              "url": "/d/technician-uptime-overview?var-probe=${__field.labels.name}&var-region=${__field.labels.region}&${__url_time_range}"
            }
          ]
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "All Probes",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "technician_check_healthy{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "technician_check_duration_seconds{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "technician_check_degraded{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "technician_http_response_status{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "technician_tls_cert_expiry_days{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "expr": "technician_bgp_prefix_visible{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "format": "table",
          "instant": true,
          "refId": "F"
        },
        {
          "expr": "technician_bgp_origin_match{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "format": "table",
          "instant": true,
          "refId": "G"
        },
        {
          "expr": "technician_domain_expiry_days{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "format": "table",
          "instant": true,
          "refId": "H"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [
              { "id": "displayName", "value": "Status" },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "DOWN", "color": "red" },
                      "1": { "text": "UP", "color": "green" }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #B" },
            "properties": [
              { "id": "displayName", "value": "Duration" },
              { "id": "unit", "value": "s" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #C" },
            "properties": [
              { "id": "displayName", "value": "Degraded" },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "OK", "color": "green" },
                      "1": { "text": "DEGRADED", "color": "orange" }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #D" },
            "properties": [
              { "id": "displayName", "value": "HTTP Code" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "green", "value": 200 },
                    { "color": "yellow", "value": 300 },
                    { "color": "orange", "value": 400 },
                    { "color": "red", "value": 500 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "noValue", "value": "\u2014" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #E" },
            "properties": [
              { "id": "displayName", "value": "Cert Expiry" },
              { "id": "unit", "value": "d" },
              { "id": "decimals", "value": 0 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "orange", "value": 7 },
                    { "color": "yellow", "value": 30 },
                    { "color": "green", "value": 60 }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "gauge", "mode": "basic" }
              },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 365 },
              { "id": "noValue", "value": "\u2014" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #F" },
            "properties": [
              { "id": "displayName", "value": "BGP Visible" },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "NO", "color": "red" },
                      "1": { "text": "YES", "color": "green" }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "noValue", "value": "\u2014" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #G" },
            "properties": [
              { "id": "displayName", "value": "BGP Origin" },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "MISMATCH", "color": "red" },
                      "1": { "text": "MATCH", "color": "green" }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "noValue", "value": "\u2014" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #H" },
            "properties": [
              { "id": "displayName", "value": "Domain Expiry" },
              { "id": "unit", "value": "d" },
              { "id": "decimals", "value": 0 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "orange", "value": 14 },
                    { "color": "yellow", "value": 30 },
                    { "color": "green", "value": 90 }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "gauge", "mode": "basic" }
              },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 365 },
              { "id": "noValue", "value": "\u2014" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "name" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Drill Down →",
                    "url": "/d/technician-uptime-overview?var-probe=${__data.fields.name}&var-region=${__data.fields.region}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "__name__" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "city": true,
              "country": true
            },
            "renameByName": {
              "name": "Probe",
              "type": "Type",
              "region": "Site"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Probe Up/Down Over Time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "technician_check_healthy{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "legendFormat": "{{name}} @ {{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Degraded State Over Time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Tracks which probes are in degraded state (response time exceeds degraded_after threshold)",
      "targets": [
        {
          "expr": "technician_check_degraded{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "legendFormat": "{{name}} @ {{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 100,
      "title": "$probe",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "repeat": "probe",
      "repeatDirection": "h",
      "panels": []
    },
    {
      "id": 101,
      "title": "Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "technician_check_healthy{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "instant": true,
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 102,
      "title": "Response Time",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "technician_check_duration_seconds{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "instant": true,
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 103,
      "title": "Duration Over Time",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "technician_check_duration_seconds{region=~\"$region\", type=~\"$type\", name=~\"$probe\"}",
          "legendFormat": "{{name}} @ {{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "pointSize": 5, "showPoints": "auto", "spanNulls": false, "gradientMode": "scheme" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "continuous-GrYlRd" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ],
  "schemaVersion": 39
}
