#!/bin/sh
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

require_docker() {
    if ! docker info >/dev/null 2>&1; then
        echo "    error: Docker daemon is not running"
        echo "    Start Docker Desktop and retry."
        echo "    SKIP_HOOKS=1 skips most checks but never the secret/misconfig scan."
        exit 1
    fi
}

staged() {
    git diff --cached --name-only --diff-filter=ACMR
}

skip_slow() {
    [ "${SKIP_HOOKS:-}" = "1" ]
}

echo "==> go build"
go build ./...

echo "==> go vet"
go vet ./...

echo "==> go test -race"
go test -race ./...

echo "==> govulncheck"
if command -v govulncheck >/dev/null 2>&1; then
    govulncheck ./...
else
    echo "    govulncheck not installed, skipping (go install golang.org/x/vuln/cmd/govulncheck@latest)"
fi

echo "==> gofmt"
GO_FILES=$(staged | grep '\.go$' || true)
if [ -n "$GO_FILES" ]; then
    UNFORMATTED=$(echo "$GO_FILES" | xargs gofmt -l)
    if [ -n "$UNFORMATTED" ]; then
        echo "    unformatted files:"
        echo "$UNFORMATTED" | sed 's/^/      /'
        echo "    run: gofmt -w $UNFORMATTED"
        exit 1
    fi
fi

echo "==> promtool check rules"
if staged | grep -q '^prometheus/.*\.yml$'; then
    if skip_slow; then
        echo "    SKIP_HOOKS=1 — skipped"
    else
        require_docker
        docker run --rm --entrypoint promtool \
            -v "$REPO_ROOT/prometheus:/work" -w /work \
            prom/prometheus:latest check rules rules.yml
        if [ -f "$REPO_ROOT/prometheus/rules_test.yml" ]; then
            echo "==> promtool test rules"
            docker run --rm --entrypoint promtool \
                -v "$REPO_ROOT/prometheus:/work" -w /work \
                prom/prometheus:latest test rules rules_test.yml
        fi
    fi
fi

# An fs scan only reads the working tree, so a native trivy needs no daemon.
trivy_fs() {
    if command -v trivy >/dev/null 2>&1; then
        trivy fs "$@" --exit-code 1 --quiet --skip-dirs node_modules .
    else
        require_docker
        docker run --rm \
            -v "$REPO_ROOT:/work" \
            -v "$HOME/.cache/trivy:/root/.cache/trivy" \
            -w /work aquasec/trivy:latest \
            fs "$@" --exit-code 1 --quiet --skip-dirs node_modules .
    fi
}

# Never skipped, even with SKIP_HOOKS=1.
mkdir -p "$HOME/.cache/trivy"
command -v trivy >/dev/null 2>&1 || \
    echo "    trivy not installed, using Docker (install to skip the daemon: https://trivy.dev/latest/getting-started/installation/)"

# Unfiltered: trivy rates some real credentials below HIGH (a JWT is MEDIUM),
# so a severity filter drops them silently.
echo "==> trivy fs (secret)"
trivy_fs --scanners secret

echo "==> trivy fs (misconfig)"
trivy_fs --scanners misconfig --severity CRITICAL,HIGH

echo "==> docker compose config"
if staged | grep -qE '^(docker-compose.*\.yml|\.dockerignore|Dockerfile.*)$'; then
    docker compose config -q
fi

echo "==> shellcheck"
SH_FILES=$(staged | grep -E '(\.sh$|^\.githooks/)' || true)
if [ -n "$SH_FILES" ]; then
    if skip_slow; then
        echo "    SKIP_HOOKS=1 — skipped"
    elif command -v shellcheck >/dev/null 2>&1; then
        # shellcheck disable=SC2086  # intentional word-splitting on file list
        shellcheck $SH_FILES
    else
        echo "    shellcheck not installed, using Docker (install to skip the daemon: https://github.com/koalaman/shellcheck#installing)"
        require_docker
        # shellcheck disable=SC2086  # intentional word-splitting on file list
        docker run --rm -v "$REPO_ROOT:/work" -w /work \
            koalaman/shellcheck:stable $SH_FILES
    fi
fi

echo "==> All checks passed"
