#!/bin/sh
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ "${SKIP_HOOKS:-}" = "1" ]; then
    echo "==> SKIP_HOOKS=1 — pre-push checks skipped"
    exit 0
fi

require_docker() {
    if ! docker info >/dev/null 2>&1; then
        echo "    error: Docker daemon is not running"
        echo "    Start Docker Desktop and retry, or SKIP_HOOKS=1 to bypass."
        exit 1
    fi
}

# An fs scan only reads the working tree, so a native trivy needs no daemon.
echo "==> trivy fs (vuln)"
mkdir -p "$HOME/.cache/trivy"
if command -v trivy >/dev/null 2>&1; then
    trivy fs --scanners vuln --severity CRITICAL,HIGH \
        --exit-code 1 --quiet --skip-dirs node_modules .
else
    echo "    trivy not installed, using Docker (install to skip the daemon: https://trivy.dev/latest/getting-started/installation/)"
    require_docker
    docker run --rm \
        -v "$REPO_ROOT:/work" \
        -v "$HOME/.cache/trivy:/root/.cache/trivy" \
        -w /work aquasec/trivy:latest \
        fs --scanners vuln --severity CRITICAL,HIGH \
           --exit-code 1 --quiet --skip-dirs node_modules .
fi

echo "==> technician validate"
go run . validate \
    --config examples/technician.yml \
    --budget examples/budgets.yml \
    --exclude-type playwright \
    --fail-on-error \
    --fail-on-budget=false

echo "==> promtool check config"
if command -v promtool >/dev/null 2>&1; then
    (cd prometheus && promtool check config prometheus.yml)
else
    require_docker
    docker run --rm --entrypoint promtool \
        -v "$REPO_ROOT/prometheus:/work" -w /work \
        prom/prometheus:latest check config prometheus.yml
fi

echo "==> amtool check-config"
if command -v amtool >/dev/null 2>&1; then
    (cd prometheus && amtool check-config alertmanager.yml)
else
    # Not covered by the promtool require_docker above: that branch is skipped
    # entirely when promtool is native.
    require_docker
    docker run --rm --entrypoint amtool \
        -v "$REPO_ROOT/prometheus:/work" -w /work \
        prom/alertmanager:latest check-config alertmanager.yml
fi

if command -v go-licenses >/dev/null 2>&1; then
    echo "==> go-licenses (dependency license types)"
    # go-licenses resolves stdlib module info with logic fixed at build time, so a
    # binary built against a different Go than the active toolchain fails on every
    # std package ("does not have module info"). Rebuild the pinned version when the
    # binary's build-Go differs from the active toolchain (e.g. after a go.mod bump).
    want="$(go env GOVERSION)"
    have="$(go version -m "$(command -v go-licenses)" 2>/dev/null | awk 'NR==1{print $2}')"
    if [ "$have" != "$want" ]; then
        echo "    go-licenses built with ${have:-unknown}; rebuilding for ${want}..."
        go install "github.com/google/go-licenses@${GOLICENSES_VERSION:-v1.6.0}"
        PATH="$PATH:$(go env GOPATH)/bin"
    fi
    # Capture stderr and surface it only on failure: go-licenses is noisy about
    # non-Go (asm/cgo) files in deps on success, but hiding it also hid real
    # failures behind an opaque "failed to push".
    gl_err="$(mktemp)"
    if go-licenses check ./... --disallowed_types=forbidden,restricted,reciprocal \
        --ignore github.com/jesseheady/technician 2>"$gl_err"; then
        rm -f "$gl_err"
    else
        sed 's/^/    /' "$gl_err"
        rm -f "$gl_err"
        exit 1
    fi
else
    echo "==> go-licenses not installed — skipping license check (CI enforces it)"
fi

echo "==> All checks passed"
