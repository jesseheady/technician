# ── Discord Webhooks ──────────────────────────────────────────────
# Create webhooks via Server Settings > Integrations > Webhooks.
# Each receiver posts to its own channel; point multiple vars at the
# same URL if you want a single channel for everything.

DISCORD_WEBHOOK_CHATOPS=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_INCIDENTS=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_INFRA=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_EXPIRY=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_PERF=https://discord.com/api/webhooks/CHANGE_ME

# ── Pushover (pager) ─────────────────────────────────────────────
# Sign up at https://pushover.net, then create an Application/API
# Token for Technician alerts. The user key is on your dashboard.
# Critical alerts fire at emergency priority (requires acknowledge).

PUSHOVER_USER_KEY=CHANGE_ME
PUSHOVER_API_TOKEN=CHANGE_ME
