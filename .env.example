# =====================================================================
#  Technician - Alertmanager notification channels
# =====================================================================
#
# Environment variables consumed by the Alertmanager container via
# docker-compose.yml. Values are substituted into alertmanager.yml
# via ${VAR} substitution at container start.
#
# Quick start:
#   1. Copy only the variables you need into .env.
#   2. Uncomment the matching *_configs block in alertmanager.yml.
#   3. docker compose restart alertmanager


# ── Discord Webhooks ─────────────────────────────────────────────────
# Each receiver posts to its own channel. Point multiple vars at the
# same URL if you want a single channel for everything.
#
# Setup:
#   1. Server Settings > Integrations > Webhooks > New Webhook.
#   2. Name it (e.g. "Technician Alerts"), pick a channel.
#   3. Copy the webhook URL and paste below.
#   4. Repeat per receiver, or reuse the same URL for all.

DISCORD_WEBHOOK_CHATOPS=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_INCIDENTS=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_INFRA=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_EXPIRY=https://discord.com/api/webhooks/CHANGE_ME
DISCORD_WEBHOOK_PERF=https://discord.com/api/webhooks/CHANGE_ME


# ── Slack Webhooks ───────────────────────────────────────────────────
# Each receiver can post to a different Slack channel. Point multiple
# vars at the same URL/channel for a single channel.
#
# Setup:
#   1. https://api.slack.com/apps - create a new app (or use existing).
#   2. Enable "Incoming Webhooks" under Features.
#   3. "Add New Webhook to Workspace", pick a channel, authorize.
#   4. Copy the webhook URL and paste below.
#
# The SLACK_CHANNEL_* vars override the webhook's default channel.
# Leave as-is to use the channel chosen during webhook setup, or set
# to a #channel name to redirect. Channel override requires the Slack
# app to have chat:write scope (not just incoming-webhook).

SLACK_WEBHOOK_CHATOPS=https://hooks.slack.com/services/CHANGE_ME
SLACK_WEBHOOK_INCIDENTS=https://hooks.slack.com/services/CHANGE_ME
SLACK_WEBHOOK_INFRA=https://hooks.slack.com/services/CHANGE_ME
SLACK_WEBHOOK_EXPIRY=https://hooks.slack.com/services/CHANGE_ME
SLACK_WEBHOOK_PERF=https://hooks.slack.com/services/CHANGE_ME

SLACK_CHANNEL_CHATOPS=#alerts
SLACK_CHANNEL_INCIDENTS=#incidents
SLACK_CHANNEL_INFRA=#infrastructure
SLACK_CHANNEL_EXPIRY=#expiry
SLACK_CHANNEL_PERF=#performance


# ── Pushover (pager) ─────────────────────────────────────────────────
# Mobile push notifications for critical alerts. Emergency priority
# requires acknowledgement, making it suitable for on-call paging.
#
# Setup:
#   1. Sign up at https://pushover.net, install the mobile app.
#   2. User Key is on your dashboard after login.
#   3. Create an Application/API Token: https://pushover.net/apps/build
#   4. Paste both values below.
#
# Critical alerts fire at emergency priority (retry 30s, expire 1h,
# requires acknowledge in the Pushover app).

PUSHOVER_USER_KEY=CHANGE_ME
PUSHOVER_API_TOKEN=CHANGE_ME


# =====================================================================
#  Additional channels
# =====================================================================
#
# Commented-out receiver blocks for PagerDuty, OpsGenie, VictorOps,
# Telegram, Teams, Email, and generic webhooks are pre-configured in
# alertmanager.yml. To enable any of them:
#   1. Uncomment the *_configs block in alertmanager.yml.
#   2. Set the env vars below in your .env.
#   3. Restart: docker compose restart alertmanager
#
# ${VAR} substitution is automatic - no docker-compose.yml changes needed.
#
# For channels not listed here, see the full Alertmanager docs:
# https://prometheus.io/docs/alerting/latest/configuration/#receiver

# ── PagerDuty ────────────────────────────────────────────────────────
# PAGERDUTY_SERVICE_KEY=CHANGE_ME

# ── OpsGenie ─────────────────────────────────────────────────────────
# OPSGENIE_API_KEY=CHANGE_ME

# ── VictorOps (Splunk On-Call) ───────────────────────────────────────
# VICTOROPS_API_KEY=CHANGE_ME

# ── Telegram ─────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=CHANGE_ME
# TELEGRAM_CHAT_ID=CHANGE_ME

# ── Microsoft Teams ──────────────────────────────────────────────────
# MSTEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/CHANGE_ME

# ── Email (SMTP) ────────────────────────────────────────────────────
# SMTP_SMARTHOST=smtp.example.com:587
# SMTP_FROM=technician@example.com
# SMTP_TO=alerts@example.com
# SMTP_AUTH_USERNAME=technician@example.com
# SMTP_PASSWORD=CHANGE_ME

# ── Generic Webhook ──────────────────────────────────────────────────
# WEBHOOK_URL=https://your-endpoint.example.com/alerts
